# Copy to .env for local development. Never commit .env.
POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-local-only
TRIAGE_PROVIDER=simulated
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.2:1b
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_SECONDS=10
# Docker Compose trusts nginx on the Docker bridge. Set a precise proxy CIDR in production.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Production Compose
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=replace-with-commit-sha
